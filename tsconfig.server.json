{
  "extends": "./tsconfig.json",
  "include": ["server/**/*.ts", "prisma/**/*.ts", "src/data/mock.ts", "src/types/**/*.ts"],
  "compilerOptions": {
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["node"]
  }
}
